# Human-authored raw requests are provenance records. Git must never normalize line endings.
04_CHANGESETS/**/USER_REQUEST.txt -text

# Task reference copies are also byte-level provenance records. Preserve CRLF/LF and all other bytes exactly.
04_CHANGESETS/**/REFERENCES/** -text

# Legacy v7 raw-input paths remain protected for migration/backward compatibility.
00_INPUT/PROPOSALS/**/*.txt -text
00_INPUT/GAME_IDEA/rough_game_idea.txt -text
